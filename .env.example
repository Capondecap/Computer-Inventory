NODE_ENV=production
PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/computer-inventory

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-app.onrender.com

# File storage
UPLOAD_DIR=uploads
