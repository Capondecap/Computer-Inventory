<div class="local-nav">
    <a href="/api-keys" class="local-nav-item active">
        <i class="fas fa-key"></i>
        <span>API Keys</span>
    </a>
    <a href="/api-keys/new" class="local-nav-item">
        <i class="fas fa-plus-circle"></i>
        <span>Generate API Key</span>
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h3>API Keys</h3>
        <p class="card-subtitle">Keys are stored hashed and cannot be retrieved after creation.</p>
    </div>
    <div class="card-body">
        {{#if keys.length}}
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Owner</th>
                        <th>Preview</th>
                        <th>Status</th>
                        <th>Last Used</th>
                        <th>Expires</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each keys}}
                    <tr>
                        <td><strong>{{this.name}}</strong></td>
                        <td>
                            {{#if this.user}}
                                {{this.user.name}}<br>
                                <small class="text-muted">{{this.user.email}}</small>
                            {{else}}
                                <span class="text-muted">—</span>
                            {{/if}}
                        </td>
                        <td><code>...{{this.keyPreview}}</code></td>
                        <td>
                            {{#if this.isActive}}
                                {{#if (isExpired this.expiresAt)}}
                                    <span class="badge badge-warning">Expired</span>
                                {{else}}
                                    <span class="badge badge-success">Active</span>
                                {{/if}}
                            {{else}}
                                <span class="badge badge-danger">Revoked</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if this.lastUsedAt}}
                                {{formatDate this.lastUsedAt}}
                            {{else}}
                                <span class="text-muted">Never</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if this.expiresAt}}
                                {{formatDate this.expiresAt}}
                            {{else}}
                                <span class="text-muted">Never</span>
                            {{/if}}
                        </td>
                        <td>{{formatDate this.createdAt}}</td>
                        <td>
                            {{#if this.isActive}}
                            <button class="btn-icon btn-danger" onclick="revokeKey('{{this._id}}')" title="Revoke">
                                <i class="fas fa-ban"></i>
                            </button>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty-state">
            <i class="fas fa-key"></i>
            <h3>No API keys yet</h3>
            <p>Generate a key to allow service access via the API.</p>
            <a href="/api-keys/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> Generate API Key
            </a>
        </div>
        {{/if}}
    </div>
</div>

<script>
async function revokeKey(id) {
    if (!confirm('Revoke this API key? Services using it will lose access immediately.')) return;
    try {
        await api.delete(`/api/keys/${id}`);
        showToast('API key revoked', 'success');
        setTimeout(() => window.location.reload(), 800);
    } catch (error) {
        showToast(error.message || 'Failed to revoke key', 'error');
    }
}
</script>
