{{#> layouts/main title=title }}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">{{asset.brand}} {{asset.model}}</h1>
  <div class="btn-group">
    <a href="/assets/{{asset._id}}/edit" class="btn btn-sm btn-outline-primary">Edit</a>
    {{#eq asset.status "Available"}}
      <a href="/assignments/checkout?assetId={{asset._id}}" class="btn btn-sm btn-success">Check Out</a>
    {{/eq}}
    {{#eq asset.status "In-Use"}}
      <a href="/assignments/checkin?assetId={{asset._id}}" class="btn btn-sm btn-warning">Check In</a>
    {{/eq}}
    {{#unless (eq asset.status "Retired")}}
      <a href="/maintenance/new?assetId={{asset._id}}" class="btn btn-sm btn-secondary">Log Maintenance</a>
    {{/unless}}
    {{#if isAdmin}}
      <form method="POST" action="/assets/{{asset._id}}/delete" class="d-inline"
            onsubmit="return confirm('Retire this asset?')">
        <button type="submit" class="btn btn-sm btn-danger">Retire</button>
      </form>
    {{/if}}
  </div>
</div>

{{> partials/flash }}

<div class="row g-4">
  <!-- Asset Info Card -->
  <div class="col-md-5">
    <div class="card">
      <div class="card-header">Asset Details</div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Item ID</span><code>{{asset.itemId}}</code>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Serial</span><code>{{asset.serialNumber}}</code>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Brand</span><span>{{asset.brand}}</span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Model</span><span>{{asset.model}}</span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Category</span><span>{{asset.category}}</span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Type</span><span>{{asset.type}}</span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Status</span>
          <span class="badge
            {{#eq asset.status 'Available'}}bg-success{{/eq}}
            {{#eq asset.status 'In-Use'}}bg-primary{{/eq}}
            {{#eq asset.status 'Maintenance'}}bg-warning text-dark{{/eq}}
            {{#eq asset.status 'Retired'}}bg-secondary{{/eq}}">
            {{asset.status}}
          </span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Date Acquired</span><span>{{formatDate asset.dateAcquired}}</span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Age</span>
          <span>
            {{asset.ageInYears}} yrs
            {{#if asset.isAging}}<span class="badge bg-danger ms-1">Aging</span>{{/if}}
          </span>
        </li>
        {{#if asset.assignedTo}}
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted">Assigned To</span>
          <span>{{asset.assignedTo.name}} <small class="text-muted">&lt;{{asset.assignedTo.email}}&gt;</small></span>
        </li>
        {{/if}}
        {{#if asset.notes}}
        <li class="list-group-item">
          <span class="text-muted d-block">Notes</span>{{asset.notes}}
        </li>
        {{/if}}
      </ul>
    </div>
  </div>

  <!-- History -->
  <div class="col-md-7">
    <div class="card">
      <div class="card-header">Assignment History</div>
      <div class="card-body p-0">
        {{#if history.length}}
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th>Assigned To</th>
              <th>Checkout</th>
              <th>Returned</th>
              <th>Duration</th>
              <th>Docs</th>
            </tr>
          </thead>
          <tbody>
            {{#each history}}
            <tr>
              <td>{{assignedTo.name}}</td>
              <td><small>{{formatDate checkoutDate}}</small></td>
              <td>
                {{#if checkinDate}}
                  <small>{{formatDate checkinDate}}</small>
                {{else}}
                  <span class="text-muted">—</span>
                {{/if}}
              </td>
              <td><small>{{durationDays}}d</small></td>
              <td>
                {{#if checkoutDocument}}
                  <a href="/uploads/{{checkoutDocument.filename}}" target="_blank" class="me-1" title="Checkout doc">📄</a>
                {{/if}}
                {{#if checkinDocument}}
                  <a href="/uploads/{{checkinDocument.filename}}" target="_blank" title="Return doc">📄</a>
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
          <p class="text-muted text-center py-4 mb-0">No assignment history yet.</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>
{{/> layouts/main }}
