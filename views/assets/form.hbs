<div class="page-actions">
    <a href="/assets" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Assets
    </a>
</div>

<div class="form-container">
    <div class="card">
        <div class="card-header">
            <h2>{{#if asset}}Edit Asset{{else}}Add New Asset{{/if}}</h2>
        </div>
        <div class="card-body">
            {{#if formError}}
            <div class="alert alert-error" role="alert">
                <i class="fas fa-exclamation-circle"></i>
                <div class="alert-content">
                    <strong>Unable to save asset</strong>
                    <p>{{formError}}</p>
                </div>
            </div>
            {{/if}}

            <form action="{{#if asset}}/assets/{{asset._id}}{{else}}/assets{{/if}}" method="POST" id="asset-form" data-asset-id="{{asset._id}}" novalidate>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="serialNumber" class="required">Serial Number</label>
                        <input 
                            type="text" 
                            id="serialNumber" 
                            name="serialNumber" 
                            class="form-control" 
                            placeholder="e.g., SN123456789"
                            value="{{asset.serialNumber}}"
                            required
                        >
                        <small class="form-help">Unique identifier from manufacturer</small>
                        <span class="form-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label for="itemId">Asset ID</label>
                        <input
                            type="text"
                            id="itemId"
                            name="itemId"
                            class="form-control"
                            placeholder="Auto-generated if empty"
                            value="{{asset.itemId}}"
                            {{#if asset}}readonly{{/if}}
                        >
                        <small class="form-help">Leave empty for auto-generation</small>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="brand" class="required">Brand</label>
                        <input 
                            type="text" 
                            id="brand" 
                            name="brand" 
                            class="form-control" 
                            placeholder="e.g., Dell, HP, Lenovo"
                            value="{{asset.brand}}"
                            list="brand-suggestions"
                            required
                        >
                        <datalist id="brand-suggestions">
                            <option value="Dell">
                            <option value="HP">
                            <option value="Lenovo">
                            <option value="Apple">
                            <option value="Asus">
                            <option value="Acer">
                            <option value="Microsoft">
                        </datalist>
                        <span class="form-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label for="model" class="required">Model</label>
                        <input 
                            type="text" 
                            id="model" 
                            name="model" 
                            class="form-control" 
                            placeholder="e.g., Latitude 5420, ThinkPad X1"
                            value="{{asset.model}}"
                            required
                        >
                        <span class="form-error"></span>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="category" class="required">Category</label>
                        <select id="category" name="category" class="form-control" required>
                            <option value="">Select Category</option>
                            <optgroup label="Computers">
                                <option value="Laptop" {{#ifEquals asset.category 'Laptop'}}selected{{/ifEquals}}>Laptop</option>
                                <option value="Desktop" {{#ifEquals asset.category 'Desktop'}}selected{{/ifEquals}}>Desktop</option>
                                <option value="Server" {{#ifEquals asset.category 'Server'}}selected{{/ifEquals}}>Server</option>
                            </optgroup>
                            <optgroup label="Peripherals">
                                <option value="Monitor" {{#ifEquals asset.category 'Monitor'}}selected{{/ifEquals}}>Monitor</option>
                                <option value="Keyboard" {{#ifEquals asset.category 'Keyboard'}}selected{{/ifEquals}}>Keyboard</option>
                                <option value="Mouse" {{#ifEquals asset.category 'Mouse'}}selected{{/ifEquals}}>Mouse</option>
                                <option value="Printer" {{#ifEquals asset.category 'Printer'}}selected{{/ifEquals}}>Printer</option>
                                <option value="Scanner" {{#ifEquals asset.category 'Scanner'}}selected{{/ifEquals}}>Scanner</option>
                                <option value="UPS" {{#ifEquals asset.category 'UPS'}}selected{{/ifEquals}}>UPS</option>
                            </optgroup>
                            <option value="Other" {{#ifEquals asset.category 'Other'}}selected{{/ifEquals}}>Other</option>
                        </select>
                        <span class="form-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label for="status" class="required">Status</label>
                        <select id="status" name="status" class="form-control" required>
                            <option value="Available" {{#ifEquals asset.status 'Available'}}selected{{/ifEquals}}>Available</option>
                            <option value="In-Use" {{#ifEquals asset.status 'In-Use'}}selected{{/ifEquals}}>In Use</option>
                            <option value="Maintenance" {{#ifEquals asset.status 'Maintenance'}}selected{{/ifEquals}}>Maintenance</option>
                            <option value="Retired" {{#ifEquals asset.status 'Retired'}}selected{{/ifEquals}}>Retired</option>
                        </select>
                        <span class="form-error"></span>
                    </div>
                </div>
                
                <template id="assigned-to-template">
                    <div class="form-row" id="assigned-to-row">
                        <div class="form-group">
                            <label for="assignedTo" class="required">Assigned To</label>
                            <select id="assignedTo" name="assignedTo" class="form-control" required>
                                <option value="">Select User</option>
                                {{#each userOptions}}
                                    <option value="{{this._id}}" {{#ifEquals this._id ../selectedAssignedTo}}selected{{/ifEquals}}>
                                        {{this.name}} ({{this.email}})
                                    </option>
                                {{/each}}
                            </select>
                            <small class="form-help">Select the user who will be using this asset</small>
                            <span class="form-error"></span>
                        </div>
                    </div>
                </template>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="dateAcquired" class="required">Date Acquired</label>
                        <input 
                            type="date" 
                            id="dateAcquired" 
                            name="dateAcquired" 
                            class="form-control" 
                            value="{{formatDateInput asset.dateAcquired}}"
                            max="{{getCurrentDate}}"
                            required
                        >
                        <span class="form-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label for="purchasePrice">Purchase Price ($)</label>
                        <input 
                            type="number" 
                            id="purchasePrice" 
                            name="purchasePrice" 
                            class="form-control" 
                            placeholder="0.00"
                            value="{{asset.purchasePrice}}"
                            min="0"
                            step="0.01"
                        >
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="warrantyExpiry">Warranty Expiry</label>
                        <input 
                            type="date" 
                            id="warrantyExpiry" 
                            name="warrantyExpiry" 
                            class="form-control" 
                            value="{{formatDateInput asset.warrantyExpiry}}"
                        >
                    </div>
                    
                    <div class="form-group">
                        <label for="location">Location</label>
                        <input 
                            type="text" 
                            id="location" 
                            name="location" 
                            class="form-control" 
                            placeholder="e.g., Building A, Floor 3, Room 301"
                            value="{{asset.location}}"
                        >
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="specifications">Specifications</label>
                    <textarea 
                        id="specifications" 
                        name="specifications" 
                        class="form-control" 
                        rows="4"
                        placeholder="CPU: Intel Core i7-11800H&#10;RAM: 16GB DDR4&#10;Storage: 512GB NVMe SSD&#10;Display: 15.6&quot; FHD"
                    >{{asset.specifications}}</textarea>
                    <small class="form-help">Enter technical specifications (one per line)</small>
                </div>
                
                <div class="form-group">
                    <label for="notes">Notes</label>
                    <textarea 
                        id="notes" 
                        name="notes" 
                        class="form-control" 
                        rows="3"
                        placeholder="Additional notes or comments..."
                    >{{asset.notes}}</textarea>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> {{#if asset}}Update Asset{{else}}Create Asset{{/if}}
                    </button>
                    <a href="/assets" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/js/asset-form.js"></script>
