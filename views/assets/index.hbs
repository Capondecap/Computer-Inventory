<div class="page-actions">
    <a href="/assets/new" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Asset
    </a>
    <button class="btn btn-secondary" id="export-btn">
        <i class="fas fa-download"></i> Export
    </button>
</div>

<!-- Filters and Search -->
<div class="filter-panel">
    <form action="/assets" method="GET" class="filter-form">
        <div class="filter-row">
            <div class="filter-group">
                <input 
                    type="text" 
                    name="search" 
                    placeholder="Search by serial, model, brand..." 
                    class="form-control"
                    value="{{query.search}}"
                >
            </div>
            
            <div class="filter-group">
                <select name="category" class="form-control">
                    <option value="">All Categories</option>
                    <option value="Laptop" {{#ifEquals query.category 'Laptop'}}selected{{/ifEquals}}>Laptop</option>
                    <option value="Desktop" {{#ifEquals query.category 'Desktop'}}selected{{/ifEquals}}>Desktop</option>
                    <option value="Server" {{#ifEquals query.category 'Server'}}selected{{/ifEquals}}>Server</option>
                    <option value="Monitor" {{#ifEquals query.category 'Monitor'}}selected{{/ifEquals}}>Monitor</option>
                    <option value="Keyboard" {{#ifEquals query.category 'Keyboard'}}selected{{/ifEquals}}>Keyboard</option>
                    <option value="Mouse" {{#ifEquals query.category 'Mouse'}}selected{{/ifEquals}}>Mouse</option>
                    <option value="Printer" {{#ifEquals query.category 'Printer'}}selected{{/ifEquals}}>Printer</option>
                    <option value="Other" {{#ifEquals query.category 'Other'}}selected{{/ifEquals}}>Other</option>
                </select>
            </div>
            
            <div class="filter-group">
                <select name="status" class="form-control">
                    <option value="">All Statuses</option>
                    <option value="Available" {{#ifEquals query.status 'Available'}}selected{{/ifEquals}}>Available</option>
                    <option value="In-Use" {{#ifEquals query.status 'In-Use'}}selected{{/ifEquals}}>In Use</option>
                    <option value="Maintenance" {{#ifEquals query.status 'Maintenance'}}selected{{/ifEquals}}>Maintenance</option>
                    <option value="Retired" {{#ifEquals query.status 'Retired'}}selected{{/ifEquals}}>Retired</option>
                </select>
            </div>
            
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Filter
                </button>
                <a href="/assets" class="btn btn-secondary">
                    <i class="fas fa-redo"></i> Reset
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Assets Table -->
<div class="card">
    <div class="card-body">
        {{#if assets.length}}
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>
                            <input type="checkbox" id="select-all" aria-label="Select all">
                        </th>
                        <th>Asset ID</th>
                        <th>Serial Number</th>
                        <th>Model</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Acquired</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each assets}}
                    <tr>
                        <td>
                            <input type="checkbox" class="row-select" value="{{this._id}}" aria-label="Select asset">
                        </td>
                        <td>
                            <a href="/assets/{{this._id}}" class="asset-link">{{this.assetId}}</a>
                        </td>
                        <td>
                            <code class="serial-number">{{this.serialNumber}}</code>
                        </td>
                        <td>{{this.model}}</td>
                        <td>{{this.brand}}</td>
                        <td>
                            <span class="badge badge-category">
                                <i class="fas {{getCategoryIcon this.category}}"></i>
                                {{this.category}}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-{{getStatusClass this.status}}">
                                {{this.status}}
                            </span>
                        </td>
                        <td>{{formatDate this.dateAcquired}}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="/assets/{{this._id}}" class="btn-icon" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/assets/{{this._id}}/edit" class="btn-icon" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/assets/{{this._id}}/history" class="btn-icon" title="View History">
                                    <i class="fas fa-history"></i>
                                </a>
                                {{#if (isAdmin ../user.role)}}
                                <button class="btn-icon btn-danger" onclick="deleteAsset('{{this._id}}')" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        
        {{> pagination}}
        
        {{else}}
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>No assets found</h3>
            <p>Try adjusting your filters or add a new asset to get started.</p>
            <a href="/assets/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Asset
            </a>
        </div>
        {{/if}}
    </div>
</div>

<script>
// Select all checkbox functionality
document.getElementById('select-all')?.addEventListener('change', function() {
    document.querySelectorAll('.row-select').forEach(checkbox => {
        checkbox.checked = this.checked;
    });
});

// Delete confirmation
function deleteAsset(id) {
    if (confirm('Are you sure you want to delete this asset? This action cannot be undone.')) {
        fetch(`/api/items/${id}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            } else {
                alert('Error deleting asset: ' + data.message);
            }
        })
        .catch(error => {
            alert('Error deleting asset');
            console.error(error);
        });
    }
}

// Export functionality
document.getElementById('export-btn')?.addEventListener('click', function() {
    const params = new URLSearchParams(window.location.search);
    window.location.href = '/api/items/export?' + params.toString();
});
</script>
