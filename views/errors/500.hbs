<div class="error-page">
    <div class="error-icon"><i class="fas fa-exclamation-triangle"></i></div>
    <h1 class="error-code">500</h1>
    <h2 class="error-title">Internal Server Error</h2>
    <p class="error-message">{{#if message}}{{message}}{{else}}Something went wrong on our end. Please try again later.{{/if}}</p>
    <div class="error-actions">
        <a href="/dashboard" class="btn btn-primary"><i class="fas fa-home"></i> Go to Dashboard</a>
        <a href="javascript:history.back()" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Go Back</a>
    </div>
</div>
<style>
.error-page { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:4rem 2rem; text-align:center; }
.error-icon { font-size:4rem; color:#EF4444; margin-bottom:1rem; }
.error-code { font-size:6rem; font-weight:700; color:#E5E7EB; margin:0; line-height:1; }
.error-title { font-size:1.75rem; margin:0.5rem 0 1rem; }
.error-message { color:#6B7280; margin-bottom:2rem; max-width:400px; }
.error-actions { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
</style>
