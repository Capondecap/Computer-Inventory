<div class="dashboard">
    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">
                <i class="fas fa-laptop"></i>
            </div>
            <div class="stat-content">
                <h3>{{stats.totalAssets}}</h3>
                <p>Total Assets</p>
            </div>
        </div>
        
        <div class="stat-card stat-success">
            <div class="stat-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>{{stats.availableAssets}}</h3>
                <p>Available</p>
            </div>
            <div class="stat-percentage">
                {{stats.availablePercentage}}% of total
            </div>
        </div>
        
        <div class="stat-card stat-warning">
            <div class="stat-icon">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="stat-content">
                <h3>{{stats.assignedAssets}}</h3>
                <p>In Use</p>
            </div>
            <div class="stat-percentage">
                {{stats.assignedPercentage}}% of total
            </div>
        </div>
        
        <div class="stat-card stat-danger">
            <div class="stat-icon">
                <i class="fas fa-tools"></i>
            </div>
            <div class="stat-content">
                <h3>{{stats.maintenanceAssets}}</h3>
                <p>Maintenance</p>
            </div>
            <div class="stat-change negative">
                <i class="fas fa-exclamation-triangle"></i> Attention needed
            </div>
        </div>
    </div>
    
    <!-- Charts Row -->
    <div class="dashboard-row">
        <div class="dashboard-card chart-card">
            <div class="card-header">
                <h3>Asset Distribution by Category</h3>
                <div class="card-actions">
                    <button class="btn-icon refresh-dashboard" data-chart="category" aria-label="Refresh">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        
        <div class="dashboard-card chart-card">
            <div class="card-header">
                <h3>Asset Status Overview</h3>
                <div class="card-actions">
                    <button class="btn-icon refresh-dashboard" data-chart="status" aria-label="Refresh">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
    
    <div class="dashboard-row full-width-row">
        <div class="dashboard-card activity-card">
            <div class="card-header">
                <div class="header-with-icon">
                    <i class="fas fa-stream text-primary"></i>
                    <h3>Recent System Activity</h3>
                </div>
                <a href="/reports" class="btn btn-sm btn-outline">View Full Audit <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="card-body">
                {{#if recentActivity}}
                <div class="activity-timeline">
                    {{#each recentActivity}}
                    <div class="timeline-item">
                        <div class="timeline-marker {{this.type}}">
                            <i class="fas {{this.icon}}"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <span class="timeline-title">{{this.description}}</span>
                                <span class="timeline-time">{{formatDateTime this.timestamp}}</span>
                            </div>
                            <div class="timeline-body">
                                <div class="timeline-user">
                                    <i class="fas fa-user-circle"></i>
                                    <span>Performed by <strong>{{this.user}}</strong></span>
                                </div>
                                <span class="badge badge-outline-{{this.type}}">{{this.label}}</span>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="empty-state">
                    <i class="fas fa-history"></i>
                    <p>No recent activity has been recorded yet.</p>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- Alerts Section -->
    {{#if alerts}}
    <div class="dashboard-card alerts-card">
        <div class="card-header">
            <h3>Alerts & Notifications</h3>
        </div>
        <div class="card-body">
            <div class="alerts-list">
                {{#each alerts}}
                <div class="alert-item alert-{{this.level}}">
                    <div class="alert-icon">
                        <i class="fas {{this.icon}}"></i>
                    </div>
                    <div class="alert-content">
                        <p>{{this.message}}</p>
                        {{#if this.action}}
                        <a href="{{this.actionLink}}" class="alert-action">{{this.action}}</a>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    let categoryChartInstance, statusChartInstance;

    // Category Distribution Chart
    const categoryCtx = document.getElementById('categoryChart');
    if (categoryCtx) {
        categoryChartInstance = new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: {{{json categoryLabels}}},
                datasets: [{
                    data: {{{json categoryData}}},
                    backgroundColor: ['#4F46E5', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#06B6D4'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { padding: 15, usePointStyle: true } } }
            }
        });
    }
    
    // Status Overview Chart
    const statusCtx = document.getElementById('statusChart');
    if (statusCtx) {
        statusChartInstance = new Chart(statusCtx, {
            type: 'bar',
            data: {
                labels: {{{json statusLabels}}},
                datasets: [{
                    label: 'Assets',
                    data: {{{json statusData}}},
                    backgroundColor: ['#10B981', '#F59E0B', '#EF4444', '#6B7280'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    }

    // Targeted Refresh Logic
    document.querySelectorAll('.refresh-dashboard').forEach(btn => {
        btn.addEventListener('click', async function() {
            const chartType = this.dataset.chart;
            const icon = this.querySelector('i');
            
            icon.classList.add('fa-spin');
            
            try {
                const response = await fetch('/api/dashboard/stats');
                const data = await response.json();
                
                if (chartType === 'category' && categoryChartInstance) {
                    categoryChartInstance.data.labels = data.categoryLabels;
                    categoryChartInstance.data.datasets[0].data = data.categoryData;
                    categoryChartInstance.update();
                } else if (chartType === 'status' && statusChartInstance) {
                    statusChartInstance.data.datasets[0].data = data.statusData;
                    statusChartInstance.update();
                }
            } catch (err) {
                console.error('Refresh failed:', err);
            } finally {
                setTimeout(() => icon.classList.remove('fa-spin'), 600);
            }
        });
    });
});
</script>
