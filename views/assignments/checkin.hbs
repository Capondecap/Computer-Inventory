<div class="page-actions">
    <a href="/assignments" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Assignments
    </a>
</div>

<div class="form-container">
    <div class="card">
        <div class="card-header">
            <h2>
                <i class="fas fa-sign-in-alt"></i>
                Check In Asset
            </h2>
            <p class="card-subtitle">Return an asset and update its status</p>
        </div>
        <div class="card-body">
            <form action="/assignments/checkin" method="POST" id="checkin-form" enctype="multipart/form-data" novalidate>
                <!-- Asset Selection -->
                <div class="form-section">
                    <h3 class="section-title">
                        <i class="fas fa-laptop"></i> Select Asset to Check In
                    </h3>
                    
                    <div class="form-group">
                        <label for="assetId" class="required">Assigned Asset</label>
                        <select id="assetId" name="assetId" class="form-control" required>
                            <option value="">-- Select Asset by ID or Serial Number --</option>
                            {{#each assignedAssets}}
                                <option value="{{this._id}}" 
                                        data-asset-id="{{this.itemId}}" 
                                        data-name="{{this.brand}} {{this.model}}" 
                                        data-serial="{{this.serialNumber}}"
                                        data-assigned-to="{{this.assignment.user.name}}">
                                    {{this.itemId}} — SN: {{this.serialNumber}} (Assigned to: {{this.assignment.user.name}})
                                </option>
                            {{/each}}
                        </select>
                        <small class="form-help">Only assets currently "In-Use" are shown here</small>
                        <span class="form-error"></span>
                    </div>
                    
                    <div id="selectedAsset" class="selected-item" style="display: none;">
                        <div class="item-header">
                            <h4>Selected Asset Details</h4>
                        </div>
                        <div class="item-details">
                            <div class="item-icon">
                                <i class="fas fa-laptop"></i>
                            </div>
                            <div class="item-info">
                                <strong id="selectedAssetName"></strong>
                                <p id="selectedAssetDetails"></p>
                                <div class="assignment-info">
                                    <span class="info-label">Assigned to:</span>
                                    <strong id="assignedUser"></strong>
                                </div>
                                <div class="assignment-info">
                                    <span class="info-label">Current Status:</span>
                                    <span class="badge badge-info">In-Use</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Check-in Details -->
                <div class="form-section">
                    <h3 class="section-title">
                        <i class="fas fa-clipboard-check"></i> Check-in Details
                    </h3>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="checkinDate" class="required">Check-in Date</label>
                            <input 
                                type="date" 
                                id="checkinDate" 
                                name="checkinDate" 
                                class="form-control" 
                                value="{{getCurrentDate}}"
                                max="{{getCurrentDate}}"
                                required
                            >
                            <span class="form-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label for="condition" class="required">Asset Condition</label>
                            <select id="condition" name="condition" class="form-control" required>
                                <option value="">Select Condition</option>
                                <option value="Good">Good - No issues</option>
                                <option value="Fair">Fair - Minor wear</option>
                                <option value="Poor">Poor - Needs repair</option>
                            </select>
                            <span class="form-error"></span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="newStatus" class="required">New Asset Status</label>
                        <select id="newStatus" name="newStatus" class="form-control" required>
                            <option value="Available">Available</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Retired">Retired</option>
                        </select>
                        <small class="form-help">Set to "Maintenance" if repairs are needed</small>
                        <span class="form-error"></span>
                    </div>
                    
                    <div class="form-group">
                        <label for="notes">Inspection Notes</label>
                        <textarea 
                            id="notes" 
                            name="notes" 
                            class="form-control" 
                            rows="4"
                            placeholder="Document any damage, missing items, or issues found during inspection..."
                        ></textarea>
                        <small class="form-help">Include details about physical condition, functionality, accessories, etc.</small>
                    </div>
                    
                    <div class="form-group">
                        <label for="document">Inspection Document</label>
                        <div class="file-upload-area" id="fileUploadArea">
                            <input 
                                type="file" 
                                id="document" 
                                name="document" 
                                accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"
                                style="display: none;"
                            >
                            <div class="upload-placeholder">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Click to upload or drag and drop</p>
                                <small>PDF, DOC, DOCX, PNG, JPG (Max 5MB)</small>
                            </div>
                            <div class="upload-preview" style="display: none;">
                                <i class="fas fa-file"></i>
                                <span class="file-name"></span>
                                <button type="button" class="btn-icon-sm" onclick="clearFile()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <small class="form-help">Upload photos of damage or inspection report</small>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-sign-in-alt"></i> Check In Asset
                    </button>
                    <a href="/assignments" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const assetSelect = document.getElementById('assetId');
    const selectedAssetDiv = document.getElementById('selectedAsset');
    const selectedAssetName = document.getElementById('selectedAssetName');
    const selectedAssetDetails = document.getElementById('selectedAssetDetails');

    assetSelect?.addEventListener('change', function() {
        const option = this.options[this.selectedIndex];
        if (this.value) {
            selectedAssetName.textContent = option.dataset.assetId;
            selectedAssetDetails.textContent = `${option.dataset.name} — SN: ${option.dataset.serial}`;
            document.getElementById('assignedUser').textContent = option.dataset.assignedTo || 'Unknown';
            selectedAssetDiv.style.display = 'block';
        } else {
            selectedAssetDiv.style.display = 'none';
        }
    });

    // Auto-select status based on condition
    document.getElementById('condition')?.addEventListener('change', function() {
        const statusSelect = document.getElementById('newStatus');
        if (this.value === 'Poor') {
            statusSelect.value = 'Maintenance';
        } else {
            statusSelect.value = 'Available';
        }
    });

    // File upload handling
    const fileArea = document.getElementById('fileUploadArea');
    const fileInput = document.getElementById('document');
    
    fileArea?.addEventListener('click', () => fileInput.click());
    
    fileInput?.addEventListener('change', function() {
        if (this.files && this.files[0]) {
            const fileName = this.files[0].name;
            document.querySelector('.upload-placeholder').style.display = 'none';
            document.querySelector('.upload-preview').style.display = 'flex';
            document.querySelector('.file-name').textContent = fileName;
        }
    });

    // Form submission
    document.getElementById('checkin-form')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const assetId = document.getElementById('assetId').value;
        if (!assetId) {
            showToast('Please select an asset to check in', 'error');
            return;
        }

        const btn = this.querySelector('[type="submit"]');
        setButtonLoading(btn, true);
        
        const formData = new FormData(this);
        
        try {
            const response = await fetch('/api/transactions/checkin', {
                method: 'POST',
                body: formData
            });
            
            const data = await response.json();
            
            if (!response.ok) {
                throw new Error(data.message || 'Check-in failed');
            }
            
            showToast('Asset checked in successfully', 'success');
            setTimeout(() => window.location.href = '/assignments', 1000);
        } catch (err) {
            showToast(err.message || 'Check-in failed', 'error');
            setButtonLoading(btn, false);
        }
    });
});

function clearFile() {
    const fileInput = document.getElementById('document');
    fileInput.value = '';
    document.querySelector('.upload-placeholder').style.display = 'block';
    document.querySelector('.upload-preview').style.display = 'none';
}
</script>
