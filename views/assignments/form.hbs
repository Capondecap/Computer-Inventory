{{#> layouts/main title=title }}
<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">
        <h4 class="mb-0">
          {{#eq action "checkout"}}Check Out Asset{{else}}Check In Asset{{/eq}}
        </h4>
      </div>
      <div class="card-body">
        {{> partials/flash }}

        <form method="POST"
              action="/assignments/{{action}}"
              enctype="multipart/form-data">

          <div class="mb-3">
            <label class="form-label">Asset ID <span class="text-danger">*</span></label>
            <input type="text" name="assetId" class="form-control"
                   value="{{assetId}}"
                   placeholder="MongoDB _id of the asset" required>
            <div class="form-text">Enter the asset's database ID.</div>
          </div>

          {{#eq action "checkout"}}
          <div class="mb-3">
            <label class="form-label">Assign To (User ID) <span class="text-danger">*</span></label>
            <input type="text" name="assignedToId" class="form-control"
                   placeholder="User's database _id" required>
          </div>
          {{/eq}}

          <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="3"
              placeholder="{{#eq action 'checkout'}}Checkout notes…{{else}}Inspection notes…{{/eq}}"></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label">
              Reference Document
              <span class="text-muted">(PDF, image, or Word — max 10 MB)</span>
            </label>
            <input type="file" name="document" class="form-control"
                   accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx">
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn
              {{#eq action 'checkout'}}btn-success{{else}}btn-warning{{/eq}}">
              {{#eq action "checkout"}}Confirm Check Out{{else}}Confirm Check In{{/eq}}
            </button>
            <a href="/assignments" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{/> layouts/main }}
