{{#> layouts/main title=title }}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Assignments</h1>
  <div class="btn-group">
    <a href="/assignments/checkout" class="btn btn-sm btn-success">Check Out</a>
    <a href="/assignments/checkin" class="btn btn-sm btn-warning">Check In</a>
  </div>
</div>

{{> partials/flash }}

<form method="GET" action="/assignments" class="row g-2 mb-4">
  <div class="col-md-3">
    <select name="status" class="form-select form-select-sm">
      <option value="">All Statuses</option>
      <option value="Active" {{#eq query.status "Active"}}selected{{/eq}}>Active</option>
      <option value="Returned" {{#eq query.status "Returned"}}selected{{/eq}}>Returned</option>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th>Asset</th>
        <th>Assigned To</th>
        <th>By</th>
        <th>Checkout</th>
        <th>Returned</th>
        <th>Duration</th>
        <th>Status</th>
        <th>Docs</th>
      </tr>
    </thead>
    <tbody>
      {{#if items.length}}
        {{#each items}}
        <tr>
          <td>
            <a href="/assets/{{asset._id}}">
              <code>{{asset.itemId}}</code> {{asset.brand}} {{asset.model}}
            </a>
          </td>
          <td>{{assignedTo.name}}</td>
          <td><small class="text-muted">{{assignedBy.name}}</small></td>
          <td><small>{{formatDate checkoutDate}}</small></td>
          <td>
            {{#if checkinDate}}
              <small>{{formatDate checkinDate}}</small>
            {{else}}&mdash;{{/if}}
          </td>
          <td><small>{{durationDays}}d</small></td>
          <td>
            <span class="badge {{#eq status 'Active'}}bg-primary{{else}}bg-secondary{{/eq}}">
              {{status}}
            </span>
          </td>
          <td>
            {{#if checkoutDocument}}
              <a href="/uploads/{{checkoutDocument.filename}}" target="_blank" title="Checkout">📄</a>
            {{/if}}
            {{#if checkinDocument}}
              <a href="/uploads/{{checkinDocument.filename}}" target="_blank" title="Return">📋</a>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="8" class="text-center text-muted py-4">No assignments found.</td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</div>

{{> partials/pagination total=total page=page pages=pages limit=limit }}
{{/> layouts/main }}
