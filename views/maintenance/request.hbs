<div class="maintenance-container">
    <div class="card maintenance-card">
        <div class="card-header">
            <h3><i class="fas fa-wrench"></i> Create Maintenance Request</h3>
            <p class="card-subtitle">Select an asset that is currently in 'Maintenance' status to log repair details</p>
        </div>
        <div class="card-body">
            {{#if assets.length}}
            <form id="maintenance-request-form" class="premium-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="asset-select">Select Asset</label>
                        <div class="select-wrapper">
                            <i class="fas fa-laptop-medical select-icon"></i>
                            <select id="asset-select" name="assetId" required>
                                <option value="">-- Choose an asset --</option>
                                {{#each assets}}
                                <option value="{{this._id}}">{{this.itemId}} — {{this.brand}} {{this.model}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="maintenance-type">Maintenance Type</label>
                        <div class="select-wrapper">
                            <i class="fas fa-tag select-icon"></i>
                            <select id="maintenance-type" name="type" required>
                                <option value="">-- Select type --</option>
                                <option value="Repair">Repair / Fix</option>
                                <option value="Upgrade">Hardware Upgrade</option>
                                <option value="Inspection">Routine Inspection</option>
                                <option value="Cleaning">Cleaning & Maintenance</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="maintenance-priority">Priority Level</label>
                    <div class="priority-selector">
                        <label class="priority-option">
                            <input type="radio" name="priority" value="Low">
                            <span class="priority-label low">Low</span>
                        </label>
                        <label class="priority-option">
                            <input type="radio" name="priority" value="Medium" checked>
                            <span class="priority-label medium">Medium</span>
                        </label>
                        <label class="priority-option">
                            <input type="radio" name="priority" value="High">
                            <span class="priority-label high">High</span>
                        </label>
                        <label class="priority-option">
                            <input type="radio" name="priority" value="Critical">
                            <span class="priority-label critical">Critical</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="maintenance-desc">Description of Issue</label>
                    <textarea id="maintenance-desc" name="description" rows="4" placeholder="Please provide details about what needs to be fixed or maintained..." required></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-paper-plane"></i> Submit Request
                    </button>
                </div>
            </form>
            {{else}}
            <div class="empty-state">
                <i class="fas fa-check-circle"></i>
                <h3>All set!</h3>
                <p>There are no assets currently marked as 'Maintenance' that require logging.</p>
                <a href="/assets" class="btn btn-secondary">Go to Assets</a>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<style>
#maintenance-desc {
    width: 100%;
    height: 250px;
    resize: none;
    padding: 1rem;
    line-height: 1.6;
    background-color: var(--color-gray-50);
    border: 1.5px solid var(--border-color);
    border-radius: var(--border-radius);
    font-size: 1rem;
    transition: all var(--transition-fast);
}

#maintenance-desc:focus {
    background-color: white;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    outline: none;
}

.maintenance-container {
    max-width: 1400px;
    margin: 0 auto;
}

.maintenance-card { border-top: 4px solid var(--color-primary); }
.premium-form { display: flex; flex-direction: column; gap: 1.5rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.select-wrapper { position: relative; }
.select-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--color-gray-400); pointer-events: none; }
.select-wrapper select { width: 100%; padding: 0.75rem 1rem 0.75rem 2.5rem; border: 1px solid var(--border-color); border-radius: var(--border-radius); background-color: var(--color-gray-50); font-size: 1rem; appearance: none; }
.priority-selector { display: flex; gap: 1rem; margin-top: 0.5rem; }
.priority-option { flex: 1; cursor: pointer; }
.priority-option input { display: none; }
.priority-label { display: block; text-align: center; padding: 0.625rem; border-radius: var(--border-radius); border: 2px solid var(--border-color); font-size: 0.875rem; font-weight: 600; transition: all var(--transition-fast); color: var(--text-secondary); }
.priority-option input:checked + .priority-label.low { border-color: var(--color-success); background: #ecfdf5; color: #059669; }
.priority-option input:checked + .priority-label.medium { border-color: var(--color-info); background: #eff6ff; color: #2563eb; }
.priority-option input:checked + .priority-label.high { border-color: var(--color-warning); background: #fffbeb; color: #d97706; }
.priority-option input:checked + .priority-label.critical { border-color: var(--color-danger); background: #fef2f2; color: #dc2626; }
.btn-lg { padding: 1rem 2rem; font-size: 1.1rem; width: 100%; }

.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
}
.empty-state i { font-size: 4rem; color: var(--color-success); margin-bottom: 1rem; opacity: 0.5; }
</style>

<script>
// Check for stored success messages on page load (if applicable)
document.addEventListener('DOMContentLoaded', function() {
    const pendingMsg = sessionStorage.getItem('maintenance_success_msg');
    if (pendingMsg) {
        showToast(pendingMsg, 'success');
        sessionStorage.removeItem('maintenance_success_msg');
    }
});

document.getElementById('maintenance-request-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);

    try {
        const response = await fetch('/api/maintenance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
            sessionStorage.setItem('maintenance_success_msg', 'Maintenance request submitted successfully.');
            window.location.href = '/maintenance/history';
        } else {
            throw new Error(result.message || 'Failed to submit request');
        }
    } catch (err) {
        showToast(err.message, 'error');
    }
});
</script>
