{{#> layouts/main title=title }}
<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">
        <h4 class="mb-0">{{#if record._id}}Update Maintenance{{else}}Log Maintenance{{/if}}</h4>
      </div>
      <div class="card-body">
        {{> partials/flash }}

        <form method="POST"
              action="{{#if record._id}}/maintenance/{{record._id}}{{else}}/maintenance{{/if}}">

          {{#unless record._id}}
          <div class="mb-3">
            <label class="form-label">Asset ID <span class="text-danger">*</span></label>
            <input type="text" name="assetId" class="form-control"
                   value="{{assetId}}" placeholder="MongoDB _id of the asset" required>
          </div>
          {{/unless}}

          <div class="mb-3">
            <label class="form-label">Description <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="4"
                      placeholder="Describe the issue or maintenance work…"
                      {{#if record._id}}readonly{{/if}}
                      required>{{record.description}}</textarea>
          </div>

          {{#if record._id}}
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              {{#each (array "Pending" "In-Progress" "Completed")}}
                <option value="{{this}}" {{#eq this ../record.status}}selected{{/eq}}>{{this}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Resolution Notes</label>
            <textarea name="resolutionNotes" class="form-control" rows="3">{{record.resolutionNotes}}</textarea>
          </div>
          {{/if}}

          <div class="mb-4">
            <label class="form-label">Cost ($)</label>
            <input type="number" name="cost" class="form-control"
                   min="0" step="0.01" value="{{record.cost}}" placeholder="0.00">
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              {{#if record._id}}Save Update{{else}}Create Record{{/if}}
            </button>
            <a href="/maintenance" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{/> layouts/main }}
