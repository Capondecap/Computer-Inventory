<div class="maintenance-container">
    <div class="card history-card">
        <div class="card-header">
            <h3><i class="fas fa-history"></i> Maintenance History</h3>
            <p class="card-subtitle">Track and complete active maintenance tasks</p>
        </div>
        <div class="card-body">
            {{#if records.length}}
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="text-center">Asset</th>
                            <th class="text-center">Type</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each records}}
                        <tr data-id="{{this._id}}">
                            <td class="text-center">
                                <div class="asset-info">
                                    <strong>{{this.asset.itemId}}</strong>
                                    <span class="small text-muted">{{this.asset.brand}} {{this.asset.model}}</span>
                                </div>
                            </td>
                            <td class="text-center"><span class="type-tag">{{this.type}}</span></td>
                            <td class="text-center">
                                <span class="badge {{#if (eq this.status 'Pending')}}badge-warning{{else if (eq this.status 'In-Progress')}}badge-info{{else if (eq this.status 'Completed')}}badge-success{{else}}badge-secondary{{/if}}">
                                    {{this.status}}
                                </span>
                            </td>
                            <td class="text-center">{{formatDate this.createdAt}}</td>
                            <td class="text-center">
                                <div class="action-buttons" style="justify-content: center;">
                                    {{#if (eq this.status 'Pending')}}
                                    <button class="btn-icon btn-success" onclick="openResolveModal('{{this._id}}', '{{this.asset.itemId}}')" title="Resolve Maintenance">
                                        <i class="fas fa-check-circle"></i>
                                    </button>
                                    <button class="btn-icon btn-info" onclick="editMaintenance('{{this._id}}')" title="Edit Details">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    {{/if}}
                                    <button class="btn-icon btn-danger" onclick="deleteMaintenance('{{this._id}}')" title="Delete Log">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="empty-state">
                <i class="fas fa-clipboard-list"></i>
                <h3>No records found</h3>
                <p>There are no maintenance logs available at this time.</p>
                <a href="/maintenance/request" class="btn btn-primary">Log New Request</a>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<!-- RESOLVE MAINTENANCE MODAL -->
<div class="modal-overlay" id="resolveModal">
    <div class="modal-dialog" style="max-width: 500px;">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-check-circle"></i> Resolve Maintenance</h3>
                <button class="modal-close" onclick="closeModal('resolveModal')"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-4">Maintenance is complete for <strong id="resolve-asset-id"></strong>. <br>How would you like to set the asset's final status?</p>
                
                <div class="resolve-options">
                    <button class="btn btn-success btn-lg mb-3" onclick="submitResolution('Available')">
                        <i class="fas fa-check"></i> Set as Available
                    </button>
                    <button class="btn btn-warning btn-lg mb-3" onclick="submitResolution('Retired')">
                        <i class="fas fa-archive"></i> Retire Asset
                    </button>
                    <button class="btn btn-secondary" onclick="closeModal('resolveModal')">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal-overlay" id="editModal">
    <div class="modal-dialog" style="max-width: 800px;">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="fas fa-edit"></i> Edit Maintenance Details</h3>
                <button class="modal-close" onclick="closeModal('editModal')"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <form id="edit-maintenance-form">
                    <input type="hidden" id="edit-id">
                    
                    <div class="form-row" style="margin-bottom: 1.5rem;">
                        <div class="form-group">
                            <label>Maintenance Type</label>
                            <select id="edit-type" class="form-control" required>
                                <option value="Repair">Repair / Fix</option>
                                <option value="Upgrade">Hardware Upgrade</option>
                                <option value="Inspection">Routine Inspection</option>
                                <option value="Cleaning">Cleaning & Maintenance</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Priority Level</label>
                            <select id="edit-priority" class="form-control" required>
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description of Issue</label>
                        <textarea id="edit-desc" class="form-control" rows="8" style="resize:none;" placeholder="Update the issue details..." required></textarea>
                    </div>

                    <div class="modal-actions" style="margin-top: 1.5rem;">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancel</button>
                        <button type="button" class="btn btn-primary" onclick="saveEdit()">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
.maintenance-container {
    max-width: 1400px;
    margin: 0 auto;
}

.text-right { text-align: right !important; }
.text-left { text-align: left !important; }
.text-center { text-align: center !important; }

.asset-info { display: flex; flex-direction: column; align-items: center; }
.history-card { border-top: 4px solid var(--color-primary); }
.type-tag { font-weight: 600; font-size: 0.8125rem; color: var(--text-primary); }

#edit-desc {
    width: 100%;
    height: 250px;
    resize: none;
    padding: 1rem;
    line-height: 1.6;
}

.resolve-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
}

.resolve-options .btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
}

/* Modal Styling */
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 2000; opacity: 0; visibility: hidden;
    transition: all var(--transition-base);
}
.modal-overlay.show { opacity: 1; visibility: visible; }
.modal-dialog {
    background: white; width: 100%;
    border-radius: var(--border-radius-lg); box-shadow: var(--shadow-lg);
    transform: translateY(-20px); transition: all var(--transition-base);
}
.modal-overlay.show .modal-dialog { transform: translateY(0); }
.modal-header { padding: 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
.modal-body { padding: 1.5rem; }
.modal-close { background: transparent; border: none; font-size: 1.25rem; color: var(--color-gray-400); cursor: pointer; }
.modal-actions { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }

.empty-state { text-align: center; padding: 3rem; color: var(--text-secondary); }
.empty-state i { font-size: 4rem; color: var(--color-gray-300); margin-bottom: 1rem; }

.mb-4 { margin-bottom: 1.5rem; }
.mb-3 { margin-bottom: 1rem; }
</style>

<script>
let currentResolveId = null;

// Check for stored success messages on page load
document.addEventListener('DOMContentLoaded', function() {
    const pendingMsg = sessionStorage.getItem('maintenance_success_msg');
    if (pendingMsg) {
        showToast(pendingMsg, 'success');
        sessionStorage.removeItem('maintenance_success_msg');
    }
});

function openResolveModal(id, itemId) {
    currentResolveId = id;
    document.getElementById('resolve-asset-id').textContent = itemId;
    document.getElementById('resolveModal').classList.add('show');
}

async function submitResolution(targetStatus) {
    const btn = event.currentTarget;
    const originalContent = btn.innerHTML;
    
    // Disable all options in modal
    const options = document.querySelectorAll('.resolve-options .btn');
    options.forEach(o => o.disabled = true);
    
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

    try {
        const response = await fetch(`/api/maintenance/${currentResolveId}/complete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                resolution: `Maintenance completed. Asset set to ${targetStatus}.`,
                newAssetStatus: targetStatus 
            })
        });

        const result = await response.json();
        if (result.success) {
            sessionStorage.setItem('maintenance_success_msg', `Maintenance completed. Asset is now ${targetStatus}.`);
            window.location.reload();
        } else {
            throw new Error(result.message || 'Failed to complete maintenance');
        }
    } catch (err) {
        showToast(err.message, 'error');
        options.forEach(o => o.disabled = false);
        btn.innerHTML = originalContent;
    }
}

async function deleteMaintenance(id) {
    if (!confirm('Are you sure you want to delete this maintenance log?')) return;

    try {
        const response = await fetch(`/api/maintenance/${id}`, {
            method: 'DELETE'
        });
        const result = await response.json();
        if (result.success) {
            sessionStorage.setItem('maintenance_success_msg', 'Maintenance log deleted successfully.');
            window.location.reload();
        } else {
            throw new Error(result.message || 'Failed to delete log');
        }
    } catch (err) {
        showToast(err.message, 'error');
    }
}

async function editMaintenance(id) {
    try {
        const response = await fetch(`/api/maintenance/${id}`);
        const result = await response.json();
        if (result.success) {
            const data = result.data;
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-type').value = data.type;
            document.getElementById('edit-priority').value = data.priority;
            document.getElementById('edit-desc').value = data.description;
            document.getElementById('editModal').classList.add('show');
        }
    } catch (err) {
        showToast('Failed to load maintenance details', 'error');
    }
}

async function saveEdit() {
    const id = document.getElementById('edit-id').value;
    const data = {
        type: document.getElementById('edit-type').value,
        priority: document.getElementById('edit-priority').value,
        description: document.getElementById('edit-desc').value
    };

    try {
        const response = await fetch(`/api/maintenance/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            sessionStorage.setItem('maintenance_success_msg', 'Maintenance details updated successfully.');
            window.location.reload();
        } else {
            throw new Error(result.message || 'Failed to update');
        }
    } catch (err) {
        showToast(err.message, 'error');
    }
}

function closeModal(id) {
    document.getElementById(id).classList.remove('show');
}
</script>
